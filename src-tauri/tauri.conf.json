{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZCode Cleaner",
  "version": "0.1.0",
  "identifier": "com.silas.zcode-cleaner",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZCode 清理器",
        "width": 1120,
        "height": 800,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/icon.ico"]
  }
}
